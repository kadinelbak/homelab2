# Phase 3: Jarvis, AI automation, voice, Google tools, coding worker.
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME_N8N_USER_MANAGEMENT_JWT_SECRET
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_BASIC_AUTH_PASSWORD

AI_ORCHESTRATOR_TOKEN=CHANGE_ME_AI_ORCHESTRATOR_TOKEN
AI_ORCHESTRATOR_USE_OLLAMA_ROUTER=false
AI_ORCHESTRATOR_ROUTER_MODEL=llama3.1:latest
AI_ORCHESTRATOR_ROUTER_PROFILE=deep_120b
AI_ORCHESTRATOR_ROUTER_TIMEOUT=30
AI_ORCHESTRATOR_LLM_TIMEOUT=120
CALENDAR_CONTRACT_CACHE_TTL=120

JARVIS_CORE_TOKEN=CHANGE_ME_AI_ORCHESTRATOR_TOKEN
JARVIS_CORE_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@homelab_postgres:5432/jarvis_core
JARVIS_CORE_REDIS_URL=redis://:${REDIS_PASSWORD}@homelab_redis:6379/4
JARVIS_CORE_HOST_PORT=18097
JARVIS_CORE_USER_TIMEZONE=America/New_York
JARVIS_CORE_AUTOMATION_RUNNER_ENABLED=true
JARVIS_CORE_AUTOMATION_RUNNER_INTERVAL_SECONDS=60

JARVIS_CHAT_TOKEN=
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_ALLOWED_CHAT_IDS=
JARVIS_TELEGRAM_POLL_TIMEOUT=45
JARVIS_TELEGRAM_MAX_REPLY_CHARS=3500
JARVIS_TELEGRAM_BOT_URL=https://t.me/kadjarvis_bot
JARVIS_TELEGRAM_BRIEFING_VOICE_ENABLED=true

JARVIS_TTS_TOKEN=
JARVIS_TTS_ENGINE=kokoro
JARVIS_TTS_VOICE=default
JARVIS_TTS_MAX_CHARS=12000
JARVIS_TTS_ALLOW_FALLBACK=true
JARVIS_KOKORO_SPEED=1.0
JARVIS_SPANISH_PIPER_MODEL=es_MX-claude-high.onnx

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:18200/oauth/google/callback
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=

JARVIS_FAST_LLM_PROVIDER=external_openai_compatible
JARVIS_FAST_LLM_MODEL=llama-3.1-70b-instruct
JARVIS_FAST_LLM_BASE_URL=
JARVIS_FAST_LLM_API_KEY=
JARVIS_DEEP_LLM_PROVIDER=external_openai_compatible
JARVIS_DEEP_LLM_MODEL=nemotron-3-super-120b-a12b
JARVIS_DEEP_LLM_BASE_URL=
JARVIS_DEEP_LLM_API_KEY=
JARVIS_VISION_LLM_PROVIDER=external_openai_compatible
JARVIS_VISION_LLM_MODEL=gemma-4-31b-it
JARVIS_VISION_LLM_BASE_URL=
JARVIS_VISION_LLM_API_KEY=
JARVIS_LLM_TIMEOUT_SECONDS=90

CODEX_WORKER_TIMEOUT_SECONDS=1800
CODEX_WORKER_MAX_OUTPUT_CHARS=12000
CODEX_COMMAND_PREFIX=codex exec --json --sandbox workspace-write --ask-for-approval never

WHISPER_WORKER_TOKEN=
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MAX_UPLOAD_MB=100

SPANISH_COACH_TOKEN=
SPANISH_COACH_HOST_PORT=18120
SPANISH_COACH_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@homelab_postgres:5432/spanish_coach
SPANISH_COACH_REDIS_URL=redis://:${REDIS_PASSWORD}@homelab_redis:6379/5
SPANISH_COACH_LLM_MODEL=
SPANISH_COACH_LLM_BASE_URL=
SPANISH_COACH_LLM_API_KEY=
SPANISH_COACH_TTS_URL=http://tts-worker:8101
SPANISH_COACH_WHISPER_URL=http://whisper-worker:8099

SCAD_AI_HOST_PORT=18104
SCAD_AI_BIND_IP=0.0.0.0
SCAD_AI_MAX_ITERATIONS=25
SCAD_AI_OPENSCAD_TIMEOUT=90
SCAD_AI_LLM_TIMEOUT=180

MINECRAFT_EULA=FALSE
MINECRAFT_MEMORY=8G
MINECRAFT_OPS=
