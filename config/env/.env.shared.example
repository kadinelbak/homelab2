# Shared homelab defaults used by every Compose phase.
TZ=America/New_York
PUID=1000
PGID=1000
DOCKER_GID=999
DOCKER_HOST_IP=192.168.1.50
DATA_PATH=/mnt/nvme/homelab2
DOMAIN=homelab.local
TAILSCALE_HOST_IP=100.x.y.z

# Optional: when using layered env files with scripts/homelabctl.py.
# Later files override earlier files.
HOMELAB_ENV_FILES=.env,config/env/.env.shared,config/env/.env.core,config/env/.env.media,config/env/.env.media-vpn,config/env/.env.jarvis,config/env/.env.cloud
