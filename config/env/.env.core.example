# Phase 1: database, cache, identity, dashboard, monitoring, DNS.
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

AUTHENTIK_SECRET_KEY=CHANGE_ME_AUTHENTIK_SECRET_KEY
AUTHENTIK_BOOTSTRAP_EMAIL=admin@homelab.local
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_AUTHENTIK_BOOTSTRAP_PASSWORD
AUTHENTIK_ADMIN_EMAIL=admin@homelab.local

VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_VAULTWARDEN_ADMIN_TOKEN
VAULTWARDEN_ADMIN_EMAIL=admin@homelab.local
VAULTWARDEN_ADMIN_PASSWORD=CHANGE_ME_VAULTWARDEN_ADMIN_PASSWORD

BESZEL_KEY=CHANGE_ME_BESZEL_AGENT_KEY
BESZEL_TOKEN=CHANGE_ME_BESZEL_AGENT_TOKEN
BESZEL_HUB_URL=http://127.0.0.1:8090

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
PROMETHEUS_RETENTION=30d

NTFY_BASE_URL=http://homelab.local:8086
NTFY_TOPIC=homelab-alerts
WATCHTOWER_CRON="0 0 4 * * *"
WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy:80/homelab-alerts

PIHOLE_BIND_IP=100.x.y.z
PIHOLE_WEB_PORT=8053
PIHOLE_WEB_PASSWORD=CHANGE_ME_PIHOLE_WEB_PASSWORD
PIHOLE_DNS_UPSTREAMS=185.228.168.10;185.228.169.11
PIHOLE_DNSSEC=true

NUT_PASSWORD=CHANGE_ME_NUT_PASSWORD
WOL_API_KEY=CHANGE_ME_WOL_API_KEY
WOL_MAC_ADDRESS=00:11:22:33:44:55
WOL_BROADCAST_ADDRESS=255.255.255.255
WOL_PORT=9

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=alerts@homelab.local

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
RESTIC_PASSWORD=CHANGE_ME_RESTIC_PASSWORD
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
BACKUP_INTERVAL_SECONDS=86400

AUTHENTIK_URL=http://homelab.local:9001
AUTHENTIK_API_TOKEN=CHANGE_ME_AUTHENTIK_API_TOKEN
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=CHANGE_ME_GRAFANA_OIDC_CLIENT_ID
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=CHANGE_ME_GRAFANA_OIDC_CLIENT_SECRET
HOMEPAGE_AUTH_CLIENT_ID=CHANGE_ME_HOMEPAGE_OIDC_CLIENT_ID
HOMEPAGE_AUTH_CLIENT_SECRET=CHANGE_ME_HOMEPAGE_OIDC_CLIENT_SECRET
VAULTWARDEN_OIDC_CLIENT_ID=CHANGE_ME_VAULTWARDEN_OIDC_CLIENT_ID
VAULTWARDEN_OIDC_CLIENT_SECRET=CHANGE_ME_VAULTWARDEN_OIDC_CLIENT_SECRET
PORTAINER_OIDC_CLIENT_ID=CHANGE_ME_PORTAINER_OIDC_CLIENT_ID
PORTAINER_OIDC_CLIENT_SECRET=CHANGE_ME_PORTAINER_OIDC_CLIENT_SECRET

TOOLS_PUBLIC_SCHEME=http
HOMELAB_CONTROL_TOKEN=CHANGE_ME_HOMELAB_CONTROL_TOKEN
HOMELAB_RAM_LIMIT_MB=16384
HOMELAB_RESERVED_RAM_MB=2048
HOMELAB_VRAM_LIMIT_MB=4096
HOMELAB_ADMISSION_MODE=warn
