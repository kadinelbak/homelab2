# VPN-bound media automation settings.
# Keep WireGuard private keys out of env files. Store them as Docker secret files:
#   phase2-media/secrets/wireguard_private_key
#   phase2-media/secrets/wireguard_addresses
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
GLUETUN_SECRETS_DIR=/home/kadin/homelab2/phase2-media/secrets
SERVER_COUNTRIES="United States"
VPN_PORT_FORWARDING=on
QBITTORRENT_LISTEN_PORT=49092
