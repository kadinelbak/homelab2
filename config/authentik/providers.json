{
  "authorization_flow_slug": "default-provider-authorization-implicit-consent",
  "invalidation_flow_slug": "default-provider-invalidation-flow",
  "applications": [
    {
      "slug": "grafana",
      "name": "Grafana",
      "description": "Monitoring dashboards",
      "icon": "grafana",
      "launch_url": "http://${DOMAIN}:30030",
      "client_id_env": "GF_AUTH_GENERIC_OAUTH_CLIENT_ID",
      "client_secret_env": "GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET",
      "redirect_uris": [
        "http://${DOMAIN}:30030/login/generic_oauth"
      ]
    },
    {
      "slug": "n8n",
      "name": "n8n",
      "description": "Workflow automation",
      "icon": "n8n",
      "launch_url": "http://${DOMAIN}:5678",
      "client_id_env": "N8N_AUTH_OAUTH2_GENERIC_CLIENT_ID",
      "client_secret_env": "N8N_AUTH_OAUTH2_GENERIC_CLIENT_SECRET",
      "redirect_uris": [
        "http://${DOMAIN}:5678/rest/oauth2-credential/callback"
      ]
    },
    {
      "slug": "homepage",
      "name": "Homepage",
      "description": "Homelab service launcher",
      "icon": "homepage",
      "launch_url": "http://${DOMAIN}:3000",
      "client_id_env": "HOMEPAGE_AUTH_CLIENT_ID",
      "client_secret_env": "HOMEPAGE_AUTH_CLIENT_SECRET",
      "redirect_uris": [
        "http://${DOMAIN}:3000/api/auth/callback/authentik"
      ]
    },
    {
      "slug": "vaultwarden",
      "name": "Vaultwarden",
      "description": "Password manager",
      "icon": "vaultwarden",
      "launch_url": "https://${DOMAIN}:4443",
      "client_id_env": "VAULTWARDEN_OIDC_CLIENT_ID",
      "client_secret_env": "VAULTWARDEN_OIDC_CLIENT_SECRET",
      "issuer_mode": "per_provider",
      "scopes": [
        "openid",
        "email",
        "profile",
        "offline_access"
      ],
      "redirect_uris": [
        "https://${DOMAIN}:4443/identity/connect/oidc-signin"
      ]
    },
    {
      "slug": "portainer",
      "name": "Portainer",
      "description": "Container management",
      "icon": "portainer",
      "launch_url": "http://${DOMAIN}:9000",
      "client_id_env": "PORTAINER_OIDC_CLIENT_ID",
      "client_secret_env": "PORTAINER_OIDC_CLIENT_SECRET",
      "redirect_uris": [
        "http://${DOMAIN}:9000/"
      ]
    },
    {
      "slug": "homeassistant",
      "name": "Home Assistant",
      "description": "Smart home hub",
      "icon": "home-assistant",
      "launch_url": "http://${DOMAIN}:8123",
      "client_id_env": "HOME_ASSISTANT_OAUTH2_CLIENT_ID",
      "client_secret_env": "HOME_ASSISTANT_OAUTH2_CLIENT_SECRET",
      "redirect_uris": [
        "http://${DOMAIN}:8123/auth/external/callback"
      ]
    },
    {
      "slug": "immich",
      "name": "Immich",
      "description": "Photo and video library",
      "icon": "immich",
      "launch_url": "http://${DOMAIN}:2283",
      "client_id_env": "IMMICH_OIDC_CLIENT_ID",
      "client_secret_env": "IMMICH_OIDC_CLIENT_SECRET",
      "issuer_mode": "per_provider",
      "redirect_uris": [
        "http://${DOMAIN}:2283/auth/login",
        "http://${DOMAIN}:2283/user-settings",
        "app.immich:///oauth-callback"
      ]
    }
  ]
}
