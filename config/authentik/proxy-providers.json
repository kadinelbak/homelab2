      "slug": "spoolman",
      "name": "Spoolman",
      "description": "Filament tracking",
      "external_host": "https://${DOMAIN}:7912",
      "internal_host": "http://spoolman:8000",
      "auth": "authentik_proxy"
    },
    {
      "slug": "it-tools",
      "name": "IT-Tools",
