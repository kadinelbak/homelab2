{
  "notes": [
    "Use these entries for Authentik Proxy Provider or Nginx Proxy Manager forward-auth protection.",
    "Keep the upstream internal_host on http; TLS should terminate at the proxy/client-facing edge.",
    "Spoolman and IT-Tools do not have native username/password settings in this stack."
  ],
  "applications": [
