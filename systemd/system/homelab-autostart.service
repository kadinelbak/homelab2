# Starts the compose stacks in config/autostart.conf after Docker is up.
# Install: scripts/install-autostart.sh
[Unit]
Description=Start homelab compose stacks
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=kadin
WorkingDirectory=/home/kadin/homelab2
ExecStart=/home/kadin/homelab2/scripts/homelab-stacks.sh start
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
