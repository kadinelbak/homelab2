# =============================================================================
# HOMELAB ENVIRONMENT CONFIGURATION
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in EVERY value marked CHANGEME before running any compose stack.
# 3. NEVER commit .env to git – secrets live here.
# =============================================================================

# ---------------------------------------------------------------------------
# SYSTEM
# ---------------------------------------------------------------------------
TZ=America/New_York
PUID=1000
PGID=1000
DOCKER_HOST_IP=192.168.1.X          # Your host LAN IP
DOMAIN=yourdomain.com               # Root domain for all services
DATA_PATH=/mnt/nvme/homelab         # NVMe mount base – every volume maps here

# ---------------------------------------------------------------------------
# CENTRAL POSTGRESQL  (phase1 – shared by most services)
# ---------------------------------------------------------------------------
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGEME_strong_db_password

# ---------------------------------------------------------------------------
# CENTRAL REDIS  (phase1 – shared by Authentik, Paperless, etc.)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGEME_redis_password

# ---------------------------------------------------------------------------
# AUTHENTIK – SSO / Identity Provider
# Generate:  openssl rand -base64 60 | tr -d '\n'
# ---------------------------------------------------------------------------
AUTHENTIK_SECRET_KEY=CHANGEME_generate_with_openssl_rand_base64_60
AUTHENTIK_ADMIN_EMAIL=admin@yourdomain.com

# ---------------------------------------------------------------------------
# BESZEL – Monitoring
# Generate the key inside the Beszel Hub UI after first boot, then paste here.
# ---------------------------------------------------------------------------
BESZEL_KEY=CHANGEME_beszel_agent_key
BESZEL_TOKEN=CHANGEME_beszel_universal_token
BESZEL_HUB_URL=http://127.0.0.1:8090

# ---------------------------------------------------------------------------
# NTFY – Push Notifications (used by Watchtower)
# ---------------------------------------------------------------------------
NTFY_TOPIC=watchtower               # Topic name for Watchtower alerts
NTFY_URL=http://ntfy:80             # Internal URL used by Watchtower

# ---------------------------------------------------------------------------
# GLUETUN / VPN  (wraps qBittorrent)
# Adjust SERVICE_PROVIDER vars to match your VPN provider's docs:
# https://github.com/qdm12/gluetun-wiki
# ---------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=mullvad        # e.g. mullvad | nordvpn | expressvpn | custom
VPN_TYPE=wireguard                  # wireguard | openvpn
WIREGUARD_PRIVATE_KEY=CHANGEME_wireguard_private_key
WIREGUARD_ADDRESSES=10.X.X.X/32     # Assigned WireGuard IP from your VPN provider
SERVER_COUNTRIES=Netherlands        # Preferred exit country

# ---------------------------------------------------------------------------
# IMMICH – Photo Backup  (uses its own dedicated PostgreSQL instance)
# ---------------------------------------------------------------------------
IMMICH_DB_PASSWORD=CHANGEME_immich_db_password
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich

# ---------------------------------------------------------------------------
# N8N – Workflow Automation
# Generate:  openssl rand -hex 32
# ---------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=CHANGEME_generate_with_openssl_rand_hex_32
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGEME_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# MINECRAFT
# ---------------------------------------------------------------------------
MINECRAFT_EULA=TRUE
MINECRAFT_MEMORY=4G                 # Tune down to 2G if RAM is tight
MINECRAFT_OPS=YourMinecraftUsername
MINECRAFT_VERSION=LATEST
MINECRAFT_TYPE=FORGE                # FORGE | FABRIC | VANILLA | PAPER

# ---------------------------------------------------------------------------
# NEXTCLOUD  (on-demand – phase4)
# ---------------------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGEME_nextcloud_admin_password
NEXTCLOUD_TRUSTED_DOMAINS=cloud.yourdomain.com

# ---------------------------------------------------------------------------
# GITEA  (on-demand – phase4)
# ---------------------------------------------------------------------------
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=CHANGEME_gitea_admin_password
GITEA_ADMIN_EMAIL=admin@yourdomain.com
GITEA_SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
GITEA_INTERNAL_TOKEN=CHANGEME_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# OUTLINE – Knowledge Base  (on-demand – phase4)
# Generate both:  openssl rand -hex 32
# ---------------------------------------------------------------------------
OUTLINE_SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
OUTLINE_UTILS_SECRET=CHANGEME_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# CAL.COM  (on-demand – phase4)
# Generate:  openssl rand -base64 32
# ---------------------------------------------------------------------------
CALCOM_NEXTAUTH_SECRET=CHANGEME_generate_with_openssl_rand_base64_32
CALCOM_CALENDSO_ENCRYPTION_KEY=CHANGEME_generate_with_openssl_rand_base64_32
CALCOM_EMAIL_FROM=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# SUPABASE  (on-demand – phase4)
# See: https://supabase.com/docs/guides/self-hosting/docker
# ---------------------------------------------------------------------------
SUPABASE_POSTGRES_PASSWORD=CHANGEME_supabase_db_password
SUPABASE_JWT_SECRET=CHANGEME_generate_at_least_32_char_secret
SUPABASE_ANON_KEY=CHANGEME_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=CHANGEME_supabase_service_key

# ---------------------------------------------------------------------------
# NOCODB  (on-demand – phase4)
# Generate:  openssl rand -hex 32
# ---------------------------------------------------------------------------
NOCODB_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
