# Homelab Environment Variables
# Copy this file to .env and fill in the values

# Basic Settings
TZ=America/New_York
DATA_PATH=/mnt/nvme/homelab2
DOMAIN=homelab.local

# PostgreSQL
POSTGRES_USER=homelab
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme

# Authentik
AUTHENTIK_SECRET_KEY=changeme-secret-key-generate-a-random-string
VAULTWARDEN_ADMIN_TOKEN=changeme-vaultwarden-admin-token-generate-random
VAULTWARDEN_ADMIN_EMAIL=admin@${DOMAIN}
VAULTWARDEN_ADMIN_PASSWORD=changeme-admin-password

# NUT (UPS)
NUT_PASSWORD=changeme-ups-password

# Beszel
BESZEL_KEY=changeme-beszel-key-generate-random-string
BESZEL_TOKEN=changeme-beszel-token-generate-random-string

# Grafana (for SSO and admin)
GF_SECURITY_ADMIN_PASSWORD=changeme-grafana-admin-password

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme-n8n-password
N8N_ENCRYPTION_KEY=changeme-n8n-encryption-key-generate-random-string-32-chars
N8N_USER_MANAGEMENT_JWT_SECRET=changeme-n8n-jwt-secret-generate-random-string

# Optional: S3 for backups
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key

# Optional: Wake-on-LAN API
WOL_API_KEY=changeme-wol-api-key-generate-random-string

# Optional: Ollama model
# OLLAMA_MODEL=llama3

# Optional: Resource Optimizer
# OPTIMIZER_INTERVAL=300
# OPTIMIZER_SAFETY_MARGIN=0.2
# OPTIMIZER_HISTORY_DAYS=7
# OPTIMIZER_ENABLE_PREDICTION=true
# OPTIMIZER_ENABLE_THERMAL=true
# OPTIMIZER_ENABLE_GPU_SHARING=true