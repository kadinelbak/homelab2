# Development Dockerfile with live reload
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install development dependencies
RUN npm install -g nodemon

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Expose ports
EXPOSE 3000 9229  # 3000 for app, 9229 for debug

# Start with nodemon for live reload
CMD ["nodemon", "--inspect=0.0.0.0", "src/index.js"]