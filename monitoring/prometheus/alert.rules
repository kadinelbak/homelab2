groups:
  - name: host.rules
    interval: 30s
    rules:
      - alert: HostHighCPUUsage
        expr: |
          100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage on {{ $labels.instance }}"
          description: "CPU usage has been above 85% for 10 minutes."

      - alert: HostHighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage on {{ $labels.instance }}"
          description: "Memory usage has been above 90% for 10 minutes."

      - alert: HostLowRootDiskSpace
        expr: (node_filesystem_avail_bytes{mountpoint="/",fstype!~"tmpfs|overlay|squashfs"} / node_filesystem_size_bytes{mountpoint="/",fstype!~"tmpfs|overlay|squashfs"}) * 100 < 10
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Low root disk space on {{ $labels.instance }}"
          description: "Root filesystem free space is below 10%."

      - alert: HostHighDiskPressure
        expr: rate(node_pressure_io_waiting_seconds_total[5m]) > 0.2
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High disk IO pressure on {{ $labels.instance }}"
          description: "The host is spending significant time stalled on disk IO."

  - name: container.rules
    interval: 30s
    rules:
      - alert: PrometheusTargetDown
        expr: up == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Prometheus target {{ $labels.job }} is down"
          description: "{{ $labels.job }} on {{ $labels.instance }} has been down for more than 3 minutes."

      - alert: ContainerHighMemoryUsage
        expr: |
          (
            container_memory_working_set_bytes{name!=""}
            / ignoring (id)
            container_spec_memory_limit_bytes{name!=""}
          ) * 100 > 90
          and ignoring (id)
          container_spec_memory_limit_bytes{name!=""} > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Container {{ $labels.name }} memory usage is high"
          description: "Container {{ $labels.name }} is using more than 90% of its configured memory limit."

      - alert: ContainerRestartingOften
        expr: increase(container_start_time_seconds{name!=""}[30m]) > 3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container {{ $labels.name }} restarted repeatedly"
          description: "Container {{ $labels.name }} appears to have restarted more than 3 times in 30 minutes."

  - name: database.rules
    interval: 30s
    rules:
      - alert: PostgresExporterDown
        expr: up{job="postgres"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "PostgreSQL exporter is down"
          description: "Prometheus cannot scrape postgres-exporter."

      - alert: PostgresHighConnections
        expr: sum(pg_stat_activity_count) > 80
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "PostgreSQL connection count is high"
          description: "PostgreSQL has more than 80 active sessions."

      - alert: RedisExporterDown
        expr: up{job="redis"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Redis exporter is down"
          description: "Prometheus cannot scrape redis-exporter."

      - alert: RedisHighMemoryUsage
        expr: (redis_memory_used_bytes / redis_memory_max_bytes) * 100 > 85 and redis_memory_max_bytes > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Redis memory usage is high"
          description: "Redis is using more than 85% of its configured max memory."

  - name: backup.rules
    interval: 60s
    rules:
      - alert: BackupFailed
        expr: homelab_backup_last_success_timestamp_seconds == 0 and homelab_backup_last_failure_timestamp_seconds > 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Homelab backup has never succeeded"
          description: "The backup job has recorded a failure but no successful run."

      - alert: BackupStale
        expr: time() - homelab_backup_last_success_timestamp_seconds > 90000
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Homelab backup is stale"
          description: "No successful backup has completed in more than 25 hours."

      - alert: BackupVerificationFailed
        expr: homelab_backup_last_verify_status == 0
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Backup verification failed"
          description: "The latest backup verification did not complete successfully."

  - name: homelab-real-health.rules
    interval: 60s
    rules:
      - alert: HomelabHealthCollectorStale
        expr: time() - homelab_real_health_last_run_timestamp_seconds > 900
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Homelab health collector is stale"
          description: "The host health collector has not written fresh metrics for more than 15 minutes."

      - alert: HomelabHealthCollectorError
        expr: homelab_real_health_collector_ok == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Homelab health collector had an error"
          description: "At least one real health check failed to run. Check homelab_real_health.json."

      - alert: DockerContainerUnhealthy
        expr: homelab_docker_containers_unhealthy > 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Docker reports unhealthy containers"
          description: "{{ $value }} Docker container(s) are unhealthy."

      - alert: DockerContainerRestarting
        expr: homelab_docker_containers_restarting > 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Docker reports restarting containers"
          description: "{{ $value }} Docker container(s) are stuck restarting."

      - alert: ImportantDiskLow
        expr: homelab_disk_free_percent < 15
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Low disk space on {{ $labels.path }}"
          description: "{{ $labels.path }} has less than 15% free space."

      - alert: ImportantDiskCritical
        expr: homelab_disk_free_percent < 8
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Critical disk space on {{ $labels.path }}"
          description: "{{ $labels.path }} has less than 8% free space."

      - alert: TorrentVpnLeakRisk
        expr: homelab_vpn_leak_safe == 0 and homelab_vpn_qbittorrent_running == 1
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "qBittorrent VPN leak risk"
          description: "qBittorrent is running but the VPN containment check is not passing."

      - alert: HomelabTlsCertificateExpiring
        expr: homelab_tls_cert_days_remaining < 14
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate expiring on {{ $labels.domain }}:{{ $labels.port }}"
          description: "The certificate has less than 14 days remaining."

      - alert: HomelabTlsCertificateInvalid
        expr: homelab_tls_cert_valid == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "TLS certificate invalid on {{ $labels.domain }}:{{ $labels.port }}"
          description: "The certificate could not be validated or is expired."

      - alert: HomelabServiceReadinessFailed
        expr: homelab_service_ready == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Service readiness failed for {{ $labels.service }}"
          description: "{{ $labels.service }} did not return a healthy readiness response."

      - alert: AuthentikTlsEdgeFailed
        expr: homelab_authentik_tls_edge_ready == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Authentik TLS edge failed on port {{ $labels.port }}"
          description: "The HTTPS edge port is not returning a valid Authentik response."
