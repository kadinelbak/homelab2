groups:
  - name: host.rules
    interval: 30s
    rules:
      - alert: HostHighCPUUsage
        expr: |
          100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage on {{ $labels.instance }}"
          description: "CPU usage has been above 85% for 10 minutes."

      - alert: HostHighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage on {{ $labels.instance }}"
          description: "Memory usage has been above 90% for 10 minutes."

      - alert: HostLowRootDiskSpace
        expr: (node_filesystem_avail_bytes{mountpoint="/",fstype!~"tmpfs|overlay|squashfs"} / node_filesystem_size_bytes{mountpoint="/",fstype!~"tmpfs|overlay|squashfs"}) * 100 < 10
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Low root disk space on {{ $labels.instance }}"
          description: "Root filesystem free space is below 10%."

      - alert: HostHighDiskPressure
        expr: rate(node_pressure_io_waiting_seconds_total[5m]) > 0.2
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High disk IO pressure on {{ $labels.instance }}"
          description: "The host is spending significant time stalled on disk IO."

  - name: container.rules
    interval: 30s
    rules:
      - alert: PrometheusTargetDown
        expr: up == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Prometheus target {{ $labels.job }} is down"
          description: "{{ $labels.job }} on {{ $labels.instance }} has been down for more than 3 minutes."

      - alert: ContainerHighMemoryUsage
        expr: |
          (
            container_memory_working_set_bytes{name!=""}
            / ignoring (id)
            container_spec_memory_limit_bytes{name!=""}
          ) * 100 > 90
          and ignoring (id)
          container_spec_memory_limit_bytes{name!=""} > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Container {{ $labels.name }} memory usage is high"
          description: "Container {{ $labels.name }} is using more than 90% of its configured memory limit."

      - alert: ContainerRestartingOften
        expr: increase(container_start_time_seconds{name!=""}[30m]) > 3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container {{ $labels.name }} restarted repeatedly"
          description: "Container {{ $labels.name }} appears to have restarted more than 3 times in 30 minutes."

  - name: database.rules
    interval: 30s
    rules:
      - alert: PostgresExporterDown
        expr: up{job="postgres"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "PostgreSQL exporter is down"
          description: "Prometheus cannot scrape postgres-exporter."

      - alert: PostgresHighConnections
        expr: sum(pg_stat_activity_count) > 80
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "PostgreSQL connection count is high"
          description: "PostgreSQL has more than 80 active sessions."

      - alert: RedisExporterDown
        expr: up{job="redis"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Redis exporter is down"
          description: "Prometheus cannot scrape redis-exporter."

      - alert: RedisHighMemoryUsage
        expr: (redis_memory_used_bytes / redis_memory_max_bytes) * 100 > 85 and redis_memory_max_bytes > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Redis memory usage is high"
          description: "Redis is using more than 85% of its configured max memory."

  - name: backup.rules
    interval: 60s
    rules:
      - alert: BackupFailed
        expr: homelab_backup_last_success_timestamp_seconds == 0 and homelab_backup_last_failure_timestamp_seconds > 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Homelab backup has never succeeded"
          description: "The backup job has recorded a failure but no successful run."

      - alert: BackupStale
        expr: time() - homelab_backup_last_success_timestamp_seconds > 90000
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Homelab backup is stale"
          description: "No successful backup has completed in more than 25 hours."

      - alert: BackupVerificationFailed
        expr: homelab_backup_last_verify_status == 0
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "Backup verification failed"
          description: "The latest backup verification did not complete successfully."
