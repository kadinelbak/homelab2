# =============================================================================
# .gitignore – Homelab Repo
# =============================================================================

# Secrets – NEVER commit these
.env
*.key
*.pem
*.crt
*.p12
secrets/
config/authentik/client-metadata.env

# Runtime data directories – these live on your NVMe, not in git
data/
**/data/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
opencode.json
*.swp
*.swo

# Logs
*.log
logs/
__pycache__/
*.py[cod]
.pytest_cache/

# Python local environments
.venv/
venv/
env/

# Backups
*.bak
*.backup
